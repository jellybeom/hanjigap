# 한지갑 설정 견본
# 이 파일을 .env로 복사해서 사용하세요. 모든 항목에 기본값이 있어 .env가 없어도 실행됩니다.
# 상대 경로는 명령을 실행한 폴더(프로젝트 루트) 기준입니다.
# 뱅크샐러드 엑셀 비밀번호는 절대 여기에 적지 않습니다. (업로드할 때마다 입력)

HANJIGAP_ENV=dev
HANJIGAP_DATA_DIR=./data
HANJIGAP_DB_PATH=./data/hanjigap.db
HANJIGAP_LOG_DIR=./logs
HANJIGAP_LOG_LEVEL=INFO
HANJIGAP_TIMEZONE=Asia/Seoul

# 웹 서버 포트 (이 컴퓨터 안에서만 열림. Cloudflare Tunnel이 이 포트로 연결)
HANJIGAP_PORT=8000

# 바깥 주소 (트레이 '한지갑 열기'가 여는 주소, H3에서 도메인을 연결한 뒤 적기)
# HANJIGAP_PUBLIC_URL=https://hanjigap.example.com

# 백업 (서버가 켜질 때·매일 한 번·정산 저장 직전 자동, 'db backup'으로 직접)
#   BACKUP_DIR: 기본 백업 폴더
#   BACKUP_COPY_DIR: 두 번째 사본 폴더 (선택). 미니PC의 다른 드라이브를 권장
#     예) HANJIGAP_BACKUP_COPY_DIR=D:/hanjigap-backup
#     이 폴더에서는 'hanjigap-날짜-시각-종류.db' 이름의 파일만 정리하고, 다른 파일은 건드리지 않아요
#     OneDrive·Google Drive 같은 동기화 폴더에 두면 가계 데이터가 클라우드로 올라가니 주의
HANJIGAP_BACKUP_DIR=./data/backups
# HANJIGAP_BACKUP_COPY_DIR=

# 운영(미니PC)에서는 아래처럼 바꾸고 'uv run hanjigap check'로 확인
#   HANJIGAP_ENV=prod  ·  CF 두 값 넣기  ·  HANJIGAP_DEV_MEMBER는 지우기

# Cloudflare Access 로그인 확인 (H단계에서 값 넣기)
#   TEAM_DOMAIN: 팀 이름(myteam) 또는 myteam.cloudflareaccess.com
#   ACCESS_AUD: Access 애플리케이션의 'Application Audience (AUD) Tag'
# HANJIGAP_CF_TEAM_DOMAIN=
# HANJIGAP_CF_ACCESS_AUD=

# 웹 서버 개발 모드 로그인 (env=dev에서만 동작, 서버는 127.0.0.1에서만 열림)
# HANJIGAP_DEV_MEMBER=sangbeom
