# 한지갑 설정 견본
# 이 파일을 .env로 복사해서 사용하세요. 모든 항목에 기본값이 있어 .env가 없어도 실행됩니다.
# 상대 경로는 명령을 실행한 폴더(프로젝트 루트) 기준입니다.
# 뱅크샐러드 엑셀 비밀번호는 절대 여기에 적지 않습니다. (업로드할 때마다 입력)

HANJIGAP_ENV=dev
HANJIGAP_DATA_DIR=./data
HANJIGAP_DB_PATH=./data/hanjigap.db
HANJIGAP_LOG_DIR=./logs
HANJIGAP_LOG_LEVEL=INFO
HANJIGAP_TIMEZONE=Asia/Seoul

# H단계(Cloudflare Access)에서 사용
# HANJIGAP_CF_TEAM_DOMAIN=
# HANJIGAP_CF_ACCESS_AUD=

# 웹 서버 개발 모드 로그인 (env=dev에서만 동작, 서버는 127.0.0.1에서만 열림)
# HANJIGAP_DEV_MEMBER=sangbeom
